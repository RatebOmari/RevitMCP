<Window x:Class="RevitClaudeMCP.UI.ScriptApprovalDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Script Execution Approval Required"
        Height="600" Width="800"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#E74C3C" Padding="15">
            <StackPanel>
                <TextBlock Text="⚠ Script Execution Approval Required"
                          FontSize="18"
                          FontWeight="Bold"
                          Foreground="White"/>
                <TextBlock Text="Review the script before allowing execution"
                          FontSize="12"
                          Foreground="#ECF0F1"
                          Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <!-- Description -->
        <Border Grid.Row="1" Background="#ECF0F1" Padding="15" BorderBrush="#BDC3C7" BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock Text="Description:" FontWeight="Bold" FontSize="12"/>
                <TextBlock Text="{Binding Description}"
                          FontSize="14"
                          Margin="0,5"
                          TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- Script Code -->
        <Grid Grid.Row="2" Margin="15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Script Code:" FontWeight="Bold" FontSize="12" Margin="0,0,0,5"/>

            <Border Grid.Row="1" BorderBrush="#BDC3C7" BorderThickness="1" Background="#F8F9FA">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                    <TextBox Text="{Binding ScriptCode}"
                            IsReadOnly="True"
                            BorderThickness="0"
                            FontFamily="Consolas"
                            FontSize="12"
                            Background="Transparent"
                            Padding="10"
                            TextWrapping="NoWrap"/>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Buttons -->
        <Border Grid.Row="3" BorderBrush="#BDC3C7" BorderThickness="0,1,0,0" Background="#ECF0F1" Padding="15">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="✓ Approve and Execute"
                       Click="ApproveButton_Click"
                       Background="#27AE60"
                       Foreground="White"
                       Width="180"/>

                <Button Content="✗ Reject"
                       Click="RejectButton_Click"
                       Background="#E74C3C"
                       Foreground="White"
                       Width="180"/>
            </StackPanel>

            <StackPanel Margin="0,10,0,0">
                <TextBlock Text="Security Note:" FontWeight="Bold" FontSize="10" Foreground="#7F8C8D"/>
                <TextBlock Text="Scripts are validated to block file I/O, network access, and process spawning. However, they have full access to Revit API."
                          FontSize="9"
                          Foreground="#95A5A6"
                          TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
