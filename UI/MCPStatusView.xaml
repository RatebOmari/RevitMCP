<UserControl x:Class="RevitClaudeMCP.UI.MCPStatusView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:RevitClaudeMCP.UI"
             Background="White">
    <UserControl.Resources>
        <local:StatusToColorConverter x:Key="StatusToColorConverter"/>

        <Style TargetType="TextBlock">
            <Setter Property="Margin" Value="0,2"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="5"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#2C3E50" Padding="10">
            <StackPanel>
                <TextBlock Text="Claude MCP Server Status"
                          FontSize="16"
                          FontWeight="Bold"
                          Foreground="White"/>
                <TextBlock Text="Real-time monitoring and control"
                          FontSize="10"
                          Foreground="#BDC3C7"/>
            </StackPanel>
        </Border>

        <!-- Status Panel -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="10">

                <!-- Server Status -->
                <Border BorderBrush="#BDC3C7" BorderThickness="1" Padding="10" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="Server Status" FontWeight="Bold" FontSize="14" Margin="0,0,0,5"/>

                        <StackPanel Orientation="Horizontal" Margin="0,5">
                            <TextBlock Text="Status:" Width="120" FontWeight="SemiBold"/>
                            <Ellipse Width="12" Height="12" Margin="0,0,5,0"
                                    Fill="{Binding ServerStatus, Converter={StaticResource StatusToColorConverter}}"/>
                            <TextBlock Text="{Binding ServerStatusText}" FontWeight="Bold"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,5">
                            <TextBlock Text="Client Connected:" Width="120" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding ClientConnectedText}"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,5">
                            <TextBlock Text="Tools Registered:" Width="120" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding ToolCount}"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,5">
                            <TextBlock Text="Pipe Name:" Width="120" FontWeight="SemiBold"/>
                            <TextBlock Text="\\.\pipe\revit-claude-mcp" FontFamily="Consolas" FontSize="10"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Log Section -->
                <TextBlock Text="Activity Log" FontWeight="Bold" FontSize="14" Margin="0,10,0,5"/>
                <Border BorderBrush="#BDC3C7" BorderThickness="1" Height="300">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Name="LogScrollViewer">
                        <TextBox Text="{Binding LogText}"
                                IsReadOnly="True"
                                BorderThickness="0"
                                FontFamily="Consolas"
                                FontSize="10"
                                TextWrapping="Wrap"
                                Background="Transparent"/>
                    </ScrollViewer>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Control Buttons -->
        <Border Grid.Row="2" BorderBrush="#BDC3C7" BorderThickness="0,1,0,0" Background="#ECF0F1" Padding="10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="Start Server"
                       Command="{Binding StartServerCommand}"
                       IsEnabled="{Binding CanStart}"
                       Background="#27AE60"
                       Foreground="White"/>

                <Button Content="Stop Server"
                       Command="{Binding StopServerCommand}"
                       IsEnabled="{Binding CanStop}"
                       Background="#E74C3C"
                       Foreground="White"/>

                <Button Content="Restart Server"
                       Command="{Binding RestartServerCommand}"
                       IsEnabled="{Binding CanRestart}"
                       Background="#3498DB"
                       Foreground="White"/>

                <Button Content="Clear Log"
                       Command="{Binding ClearLogCommand}"
                       Background="#95A5A6"
                       Foreground="White"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
